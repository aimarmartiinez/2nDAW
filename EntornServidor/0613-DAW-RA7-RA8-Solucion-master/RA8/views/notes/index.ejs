<%- include('../partials/header') %>

<h1>Les meves Notes</h1>
<a href="/notes/create" class="btn btn-success" style="margin-bottom: 20px; display: inline-block;">+ Nova Nota</a>

<!-- SOLUCIÓ TODO 3: Taula de notes -->
<% if (typeof notes === 'undefined' || notes.length === 0) { %>
    <p>No hi ha notes encara. <a href="/notes/create">Crea la primera!</a></p>
<% } else { %>
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Títol</th>
                <th>Categoria</th>
                <th>Prioritat</th>
                <th>Estat</th>
                <th>Accions</th>
            </tr>
        </thead>
        <tbody>
            <% notes.forEach(function(note) { %>
                <tr>
                    <td><%= note.id %></td>
                    <td><a href="/notes/<%= note.id %>"><%= note.title %></a></td>
                    <td><%= note.category %></td>
                    <td><span class="badge badge-<%= note.priority %>"><%= note.priority %></span></td>
                    <td><%= note.completed ? '✅ Completada' : '⏳ Pendent' %></td>
                    <td>
                        <form action="/notes/<%= note.id %>/toggle" method="POST" style="display:inline">
                            <button type="submit" class="btn btn-sm">Toggle</button>
                        </form>
                        <form action="/notes/<%= note.id %>/delete" method="POST" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
<% } %>

<%- include('../partials/footer') %>
